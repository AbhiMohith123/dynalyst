<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level2/version4" level="2" version="4">
  <model>
    <listOfCompartments>
      <compartment id="compartment" spatialDimensions="3" size="1" constant="true"/>
    </listOfCompartments>
    <listOfSpecies>
      <species id="x" compartment="compartment" initialAmount="0" substanceUnits="mole" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="y" compartment="compartment" initialAmount="0" substanceUnits="mole" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="a" value="0.1" constant="true"/>
      <parameter id="b" value="1" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="dx_dt" reversible="false">
        <listOfProducts>
          <speciesReference species="x" stoichiometry="1"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="y"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <plus/>
              <ci> a </ci>
              <apply>
                <times/>
                <cn type="integer"> -1 </cn>
                <ci> x </ci>
              </apply>
              <apply>
                <times/>
                <ci> y </ci>
                <apply>
                  <power/>
                  <ci> x </ci>
                  <cn type="integer"> 2 </cn>
                </apply>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="dy_dt" reversible="false">
        <listOfProducts>
          <speciesReference species="y" stoichiometry="1"/>
        </listOfProducts>
        <listOfModifiers>
          <modifierSpeciesReference species="x"/>
        </listOfModifiers>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <plus/>
              <ci> b </ci>
              <apply>
                <times/>
                <cn type="integer"> -1 </cn>
                <ci> y </ci>
                <apply>
                  <power/>
                  <ci> x </ci>
                  <cn type="integer"> 2 </cn>
                </apply>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
