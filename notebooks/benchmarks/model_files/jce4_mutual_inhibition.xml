<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version1/core" level="3" version="1">
  <model id="jce4_mutual_inhibition" name="jce4_mutual_inhibition">
    <notes><body xmlns="http://www.w3.org/1999/xhtml"><p>J Chem Educ 2026 Example 4: mutual inhibition, eqs 29-30, n = 4.</p></body></notes>
    <listOfCompartments><compartment id="c" spatialDimensions="3" size="1" constant="true"/></listOfCompartments>
    <listOfSpecies>
      <species id="P1" compartment="c" initialConcentration="0.6" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
      <species id="P2" compartment="c" initialConcentration="0.4" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k1" value="1.5" constant="true"/>
      <parameter id="k2" value="1.0" constant="true"/>
      <parameter id="K" value="1.0" constant="true"/>
      <parameter id="n" value="4.0" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="R1_production_P1" reversible="false" fast="false">
        <listOfProducts><speciesReference species="P1" stoichiometry="1" constant="true"/></listOfProducts>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><divide/><apply><times/><ci> k1 </ci><apply><power/><ci> K </ci><ci> n </ci></apply></apply><apply><plus/><apply><power/><ci> K </ci><ci> n </ci></apply><apply><power/><ci> P2 </ci><ci> n </ci></apply></apply></apply></math></kineticLaw>
      </reaction>
      <reaction id="R2_loss_P1" reversible="false" fast="false">
        <listOfReactants><speciesReference species="P1" stoichiometry="1" constant="true"/></listOfReactants>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><times/><ci> k2 </ci><ci> P1 </ci></apply></math></kineticLaw>
      </reaction>
      <reaction id="R3_production_P2" reversible="false" fast="false">
        <listOfProducts><speciesReference species="P2" stoichiometry="1" constant="true"/></listOfProducts>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><divide/><apply><times/><ci> k1 </ci><apply><power/><ci> K </ci><ci> n </ci></apply></apply><apply><plus/><apply><power/><ci> K </ci><ci> n </ci></apply><apply><power/><ci> P1 </ci><ci> n </ci></apply></apply></apply></math></kineticLaw>
      </reaction>
      <reaction id="R4_loss_P2" reversible="false" fast="false">
        <listOfReactants><speciesReference species="P2" stoichiometry="1" constant="true"/></listOfReactants>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><times/><ci> k2 </ci><ci> P2 </ci></apply></math></kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
