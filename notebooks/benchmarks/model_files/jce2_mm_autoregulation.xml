<?xml version="1.0" encoding="UTF-8"?>
<sbml xmlns="http://www.sbml.org/sbml/level3/version1/core" level="3" version="1">
  <model id="jce2_mm_autoregulation" name="jce2_mm_autoregulation">
    <notes><body xmlns="http://www.w3.org/1999/xhtml"><p>J Chem Educ 2026 Example 2: Michaelis-Menten positive autoregulation. dP/dt = k1 P/(K+P) - k2 P.</p></body></notes>
    <listOfCompartments><compartment id="c" spatialDimensions="3" size="1" constant="true"/></listOfCompartments>
    <listOfSpecies>
      <species id="P" compartment="c" initialConcentration="0.3" hasOnlySubstanceUnits="false" boundaryCondition="false" constant="false"/>
    </listOfSpecies>
    <listOfParameters>
      <parameter id="k1" value="1.5" constant="true"/>
      <parameter id="k2" value="1.0" constant="true"/>
      <parameter id="K" value="1.0" constant="true"/>
    </listOfParameters>
    <listOfReactions>
      <reaction id="R1_autocatalytic_production" reversible="false" fast="false">
        <listOfProducts><speciesReference species="P" stoichiometry="1" constant="true"/></listOfProducts>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><divide/><apply><times/><ci> k1 </ci><ci> P </ci></apply><apply><plus/><ci> K </ci><ci> P </ci></apply></apply></math></kineticLaw>
      </reaction>
      <reaction id="R2_loss" reversible="false" fast="false">
        <listOfReactants><speciesReference species="P" stoichiometry="1" constant="true"/></listOfReactants>
        <kineticLaw><math xmlns="http://www.w3.org/1998/Math/MathML"><apply><times/><ci> k2 </ci><ci> P </ci></apply></math></kineticLaw>
      </reaction>
    </listOfReactions>
  </model>
</sbml>
